<!-- app/views/client_contacts/index.html.erb -->
<div class="max-w-[1000px] my-8 mx-auto p-6 md:p-8 font-sans text-[#2D2B4A] bg-white rounded-xl border border-[#EAEFFC] shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
  
  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 mb-6 border-b border-[#EEF0FD]">
    <div>
      <h1 class="text-2xl font-semibold text-[#4C4682] m-0 tracking-tight">Client Contacts</h1>
      <p class="text-sm text-[#7973A8] mt-1 m-0">Manage client notes and linked contact submissions</p>
    </div>
    <%= link_to "+ New Client Contact", new_client_contact_path, class: "inline-block px-4 py-2 text-sm font-medium text-white bg-[#685FD6] rounded-lg hover:bg-[#554CBF] transition-colors no-underline shadow-sm" %>
  </div>

  <!-- Flash Messages -->
  <% if flash[:notice].present? %>
    <p class="p-3 px-4 rounded-lg text-sm mb-5 bg-[#EEF0FD] text-[#4C4682] border border-[#C7D2FE]">
      <%= flash[:notice] %>
    </p>
  <% end %>

  <% if flash[:alert].present? %>
    <p class="p-3 px-4 rounded-lg text-sm mb-5 bg-[#FEE2E2] text-[#991B1B] border border-[#FCA5A5]">
      <%= flash[:alert] %>
    </p>
  <% end %>

  <!-- Content Table / Empty State -->
  <% if @client_contacts.blank? %>
    <div class="p-12 text-center text-[#7973A8] bg-[#F8F9FE] rounded-lg border border-dashed border-[#E0E3F6]">
      <p class="text-sm m-0 font-medium">No client contacts found.</p>
      <p class="text-xs text-[#8C87B3] mt-1 mb-4">Link a contact submission to start keeping notes.</p>
      <%= link_to "+ Create First Client Contact", new_client_contact_path, class: "inline-block px-3.5 py-2 text-xs font-medium text-[#685FD6] bg-[#EEF0FD] border border-[#E0E3F6] rounded-lg hover:bg-[#685FD6] hover:text-white transition-colors no-underline" %>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b-2 border-[#EEF0FD]">
            <th class="px-3.5 py-3 font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider w-16">ID</th>
            <th class="px-3.5 py-3 font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider">Associated Contact</th>
            <th class="px-3.5 py-3 font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider">Notes</th>
            <th class="px-3.5 py-3 font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider">Date</th>
            <th class="px-3.5 py-3 text-right font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#F0F2FC]">
          <% @client_contacts.each do |client_contact| %>
            <tr class="hover:bg-[#FAFBFD] transition-colors duration-150">
              
              <!-- ID -->
              <td class="px-3.5 py-4 align-top text-[#7973A8] font-mono text-xs">
                #<%= client_contact.id %>
              </td>

              <!-- Associated Contact Info & Link -->
              <td class="px-3.5 py-4 align-top whitespace-nowrap">
                <% if client_contact.contact %>
                  <div class="font-semibold text-[#4C4682]"><%= client_contact.contact.name %></div>
                  <div class="text-xs text-[#7973A8] mb-1"><%= client_contact.contact.email %></div>
                  <%= link_to "View Submission ##{client_contact.contact_id} →", contact_path(client_contact.contact), class: "text-xs font-medium text-[#685FD6] hover:underline no-underline" %>
                <% else %>
                  <span class="text-xs text-[#7973A8] italic">Contact #<%= client_contact.contact_id %> (Deleted)</span>
                <% end %>
              </td>

              <!-- Notes Preview -->
              <td class="px-3.5 py-4 align-top max-w-xs text-[#2D2B4A]">
                <div class="line-clamp-2 text-sm leading-relaxed" title="<%= client_contact.notes %>">
                  <%= client_contact.notes.presence || "-" %>
                </div>
              </td>

              <!-- Date -->
              <td class="px-3.5 py-4 align-top whitespace-nowrap text-xs text-[#7973A8]">
                <%= client_contact.created_at.strftime("%b %d, %Y") %>
              </td>

              <!-- Actions -->
              <td class="px-3.5 py-4 align-top text-right whitespace-nowrap space-x-1">
                <%= link_to "Show", client_contact_path(client_contact), class: "inline-block px-3 py-1 text-xs font-medium text-[#685FD6] bg-[#EEF0FD] rounded-md no-underline transition-all duration-200 hover:bg-[#685FD6] hover:text-white" %>
                <%= link_to "Edit", edit_client_contact_path(client_contact), class: "inline-block px-3 py-1 text-xs font-medium text-[#7973A8] bg-[#F0F2FC] rounded-md no-underline transition-all duration-200 hover:bg-[#685FD6] hover:text-white" %>
                <%= button_to "Delete", client_contact_path(client_contact), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this client contact?" }, class: "inline-block px-2.5 py-1 text-xs font-medium bg-[#FFF0F0] text-[#D32F2F] rounded-md border-0 cursor-pointer transition-all duration-200 hover:bg-[#D32F2F] hover:text-white", form: { class: "inline" } %>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-[0.775rem] text-[#8C87B3] text-right">Showing <%= @client_contacts.size %> client contact(s)</p>
  <% end %>

</div>