<% content_for :title, "Portfolio - Shenefelt" %>

<div class="box-border flex min-h-[calc(100vh-70px)] items-center justify-center p-8 font-['Railway',ui-sans-serif,system-ui,sans-serif]">
  <div class="box-border w-full max-w-[480px] rounded-xl border border-[#EAEFFC] bg-white p-10 shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
    <h2 class="mb-1 mt-0 text-2xl font-semibold tracking-tight text-[#4C4682]">
      Projects
    </h2>
    <p class="mb-6 mt-0 text-sm text-[#7973A8]">
      selected applications & tools
    </p>

    <!-- Project 1 -->
    <div class="mb-4 box-border rounded-lg border border-[#E0E3F6] bg-[#F8F9FE] px-[1.15rem] py-4">
      <div class="mb-[0.35rem] flex items-center justify-between">
        <h3 class="m-0 text-[0.95rem] font-semibold text-[#4C4682]">
          Cloud Storage Explorer
        </h3>
        <a href="/files" class="text-[0.8rem] font-medium text-[#685FD6] no-underline hover:underline">
          View app →
        </a>
      </div>
      <p class="mb-3 mt-0 text-[0.8rem] leading-snug text-[#7973A8]">
        R2 Cloud Object Storage browser built with S3 client integration and direct uploads.
      </p>
      <div class="flex flex-wrap gap-[0.4rem]">
        <span class="rounded border border-[#E0E3F6] bg-[#F0F2FC] px-2 py-[0.2rem] text-[0.725rem] text-[#4C4682]">Ruby on Rails</span>
        <span class="rounded border border-[#E0E3F6] bg-[#F0F2FC] px-2 py-[0.2rem] text-[0.725rem] text-[#4C4682]">Cloudflare R2</span>
        <span class="rounded border border-[#E0E3F6] bg-[#F0F2FC] px-2 py-[0.2rem] text-[0.725rem] text-[#4C4682]">ActiveStorage</span>
      </div>
    </div>

    <!-- Project 2 -->
    <div class="mb-4 box-border rounded-lg border border-[#E0E3F6] bg-[#F8F9FE] px-[1.15rem] py-4">
      <div class="mb-[0.35rem] flex items-center justify-between">
        <h3 class="m-0 text-[0.95rem] font-semibold text-[#4C4682]">
          Pokedex Data Engine
        </h3>
        <a href="/pokemon" class="text-[0.8rem] font-medium text-[#685FD6] no-underline hover:underline">
          View app →
        </a>
      </div>
      <p class="mb-3 mt-0 text-[0.8rem] leading-snug text-[#7973A8]">
        Pokemon stat tracking and query system built with RESTful endpoints and caching.
      </p>
      <div class="flex flex-wrap gap-[0.4rem]">
        <span class="rounded border border-[#E0E3F6] bg-[#F0F2FC] px-2 py-[0.2rem] text-[0.725rem] text-[#4C4682]">Rails 8</span>
        <span class="rounded border border-[#E0E3F6] bg-[#F0F2FC] px-2 py-[0.2rem] text-[0.725rem] text-[#4C4682]">MySQL</span>
        <span class="rounded border border-[#E0E3F6] bg-[#F0F2FC] px-2 py-[0.2rem] text-[0.725rem] text-[#4C4682]">Pundit</span>
      </div>
    </div>

    <div class="mt-6 flex flex-col gap-3">
      <a href="<%= new_contact_path %>"
         class="box-border block rounded-lg bg-[#685FD6] px-[1.15rem] py-[0.65rem] text-center text-sm font-medium text-white no-underline transition-all duration-200 ease-in-out hover:bg-[#554CBF]">
        Get In Touch
      </a>
      <a href="/"
         class="box-border block rounded-lg bg-[#EEF0FD] px-[1.15rem] py-[0.65rem] text-center text-sm font-medium text-[#685FD6] no-underline transition-all duration-200 ease-in-out hover:bg-[#685FD6] hover:text-white">
        Back to Dashboard
      </a>
    </div>
  </div>
</div>