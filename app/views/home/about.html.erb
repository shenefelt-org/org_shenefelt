<% content_for :title, "About - Shenefelt" %>

<style>
  .main-content-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 70px);
    padding: 2rem;
    box-sizing: border-box;
    font-family: "Menlo", monospace, "Courier New", Courier, monospace;
  }

  .card {
    background: #FFFFFF;
    padding: 2.5rem;
    border-radius: 12px;
    width: 100%;
    max-width: 420px;
    border: 1px solid #EAEFFC;
    box-shadow: 0 4px 20px rgba(104, 95, 214, 0.05);
    box-sizing: border-box;
  }

  h2 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: #4C4682;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  p {
    color: #7973A8;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0 0 1rem 0;
  }

  .btn-secondary {
    display: block;
    text-align: center;
    padding: 0.65rem 1.15rem;
    background: #EEF0FD;
    color: #685FD6;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    box-sizing: border-box;
    margin-top: 1.5rem;
  }

  .btn-secondary:hover {
    background: #685FD6;
    color: #FFFFFF;
  }
</style>

<div class="main-content-wrapper">
  <div class="card">
    <h2>About</h2>
    <p>Welcome to Shenefelt. This platform handles cloud storage integrations, Pokemon data tracking, and internal utilities.</p>
    
    <a href="/" class="btn-secondary">Back to Dashboard</a>
  </div>
</div>