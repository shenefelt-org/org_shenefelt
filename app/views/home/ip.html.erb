<% content_for :title, "IP Address - Shenefelt" %>

<div class="box-border flex min-h-[calc(100vh-70px)] items-center justify-center p-8 font-['Railway',ui-sans-serif,system-ui,sans-serif]">
  <div class="box-border w-full max-w-[420px] rounded-xl border border-[#EAEFFC] bg-white p-10 shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
    <h2 class="mb-1 mt-0 text-2xl font-semibold tracking-tight text-[#4C4682]">
      Public IP
    </h2>

    <div class="mb-5 break-all rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-[0.85rem] py-4 text-center font-['Railway',ui-sans-serif,system-ui,sans-serif] text-xl font-semibold text-[#685FD6]">
      <%= @ip %>
    </div>

    <span class="mb-[0.35rem] block text-xs font-semibold uppercase tracking-wider text-[#4C4682]">
      User Agent
    </span>
    <div class="mb-6 break-all rounded-lg border border-[#E0E3F6] bg-[#F8F9FE] px-[0.85rem] py-[0.65rem] text-xs leading-snug text-[#7973A8]">
      <%= @user_agent %>
    </div>

    <a href="/"
       class="box-border block rounded-lg bg-[#EEF0FD] px-[1.15rem] py-[0.65rem] text-center text-sm font-medium text-[#685FD6] no-underline transition-all duration-200 ease-in-out hover:bg-[#685FD6] hover:text-white">
      Back to Dashboard
    </a>
  </div>
</div>