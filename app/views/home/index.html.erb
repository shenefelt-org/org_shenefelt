<% content_for :title, "Dashboard - Shenefelt" %>

<div class="box-border flex min-h-[calc(100vh-70px)] items-center justify-center p-8 font-['Railway',ui-sans-serif,system-ui,sans-serif]">
  <div class="box-border w-full max-w-[420px] rounded-xl border border-[#EAEFFC] bg-white p-10 shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
    <p class="mb-2 text-sm text-[#7973A8]">logged in as</p>

    <div class="mb-6 break-all rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-[0.85rem] py-[0.65rem] font-['Railway',ui-sans-serif,system-ui,sans-serif] text-[0.825rem] text-[#4C4682]">
      <%= @user&.email_address || @user&.email || Current.user&.email_address || Current.user&.email %>
    </div>

    <div class="flex flex-col gap-3">
      <% if policy(:dashboard).view_r2_storage_button? %>
        <a href="/files"
           class="box-border block rounded-lg bg-[#685FD6] px-[1.15rem] py-[0.65rem] text-center text-sm font-medium text-white no-underline transition-all duration-200 ease-in-out hover:bg-[#554CBF]">
          R2 Cloud Object Storage (sad-wig)
        </a>
      <% end %>



      <a href="<%= contacts_path %>"
         class="box-border block rounded-lg bg-[#EEF0FD] px-[1.15rem] py-[0.65rem] text-center text-sm font-medium text-[#685FD6] no-underline transition-all duration-200 ease-in-out hover:bg-[#685FD6] hover:text-white">
        View Contact Submissions
      </a>

      <a href="/portfolio"
         class="box-border block rounded-lg bg-[#EEF0FD] px-[1.15rem] py-[0.65rem] text-center text-sm font-medium text-[#685FD6] no-underline transition-all duration-200 ease-in-out hover:bg-[#685FD6] hover:text-white">
        Portfolio
      </a>

      <a href="https://github.com/greg0rys"
         class="box-border block rounded-lg bg-[#EEF0FD] px-[1.15rem] py-[0.65rem] text-center text-sm font-medium text-[#685FD6] no-underline transition-all duration-200 ease-in-out hover:bg-[#685FD6] hover:text-white">
        GitHub
      </a>
    </div>

    <div class="mt-6 text-center">
      <%= button_to "Log Out",
            logout_path,
            method: :delete,
            class: "cursor-pointer border-0 bg-transparent p-0 text-[0.85rem] font-medium text-[#8C87B3] transition-colors duration-200 ease-in-out hover:text-[#685FD6] hover:underline" %>
    </div>
  </div>
</div>