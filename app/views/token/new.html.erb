<!DOCTYPE html>
<html>
<head>
  <title>Request Bearer Token</title>
  <style>
    body {
      font-family: system-ui, -apple-system, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      margin: 0;
      background: #0f1016;
      color: #e2e8f0;
    }
    .card {
      background: #181926;
      padding: 2.5rem;
      border-radius: 12px;
      width: 360px;
      border: 1px solid #313244;
      box-shadow: 0 10px 30px -5px rgba(99, 102, 241, 0.2);
    }
    h2 {
      margin-top: 0;
      color: #818cf8;
      font-size: 1.5rem;
    }
    label {
      display: block;
      font-size: 0.9rem;
      color: #a5b4fc;
      margin-bottom: 6px;
    }
    input[type="email"] {
      width: 100%;
      padding: 12px;
      margin-bottom: 20px;
      border-radius: 6px;
      border: 1px solid #4338ca;
      background: #0f1016;
      color: #fff;
      box-sizing: border-box;
      font-size: 0.95rem;
      outline: none;
    }
    input[type="email"]:focus {
      border-color: #818cf8;
      box-shadow: 0 0 0 2px rgba(129, 140, 248, 0.25);
    }
    input[type="submit"] {
      width: 100%;
      padding: 12px;
      background: #6366f1;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
      font-size: 1rem;
      transition: background 0.2s ease;
    }
    input[type="submit"]:hover {
      background: #4f46e5;
    }
  </style>
</head>
<body>
<div class="card">
    <h2>Request Token</h2>
    <%= form_with url: token_path, method: :post, data: { turbo: false } do |f| %>
      <%= f.label :email, "Email Address" %>
      <%= f.email_field :email, value: @email, required: true, placeholder: "you@shenefelt.cc" %>
      <%= f.submit "Send Token" %>
    <% end %>
  </div>
</body>
</html>
