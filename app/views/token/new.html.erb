<!DOCTYPE html>
<html>
<head>
  <title>Request Bearer Token</title>
  <style>
    body { font-family: system-ui, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; background: #0f172a; color: #f8fafc; }
    .card { background: #1e293b; padding: 2rem; border-radius: 8px; width: 320px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
    input[type="email"] { width: 100%; padding: 10px; margin: 10px 0 20px 0; border-radius: 4px; border: 1px solid #475569; background: #0f172a; color: #fff; box-sizing: border-box; }
    input[type="submit"] { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    input[type="submit"]:hover { background: #1d4ed8; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Request Token</h2>
    <%= form_with url: token_path, method: :post, data: { turbo: false } do |f| %>
      <%= f.label :email, "Email Address:" %>
      <%= f.email_field :email, required: true, placeholder: "you@example.com" %>
      <%= f.submit "Send Token" %>
    <% end %>
  </div>
</body>
</html>
