<% content_for :title, "Pokemons" %>

<% if policy(Pokemon).show_edit? %>
  <div class="mx-auto mb-8 max-w-[800px] rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-6 py-4 text-sm font-medium text-[#4C4682] font-['Railway',ui-sans-serif,system-ui,sans-serif]">
    <p>Super Admin <%= current_user&.email %></p>
  </div>
<% else %>
  <div class="mx-auto mb-8 max-w-[800px] rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-6 py-4 text-sm font-medium text-[#4C4682] font-['Railway',ui-sans-serif,system-ui,sans-serif]">
    <p>You are a regular user. You can view pokemons but cannot edit them.</p>
  </div>
<% end %>

<div class="mx-auto my-12 max-w-[800px] text-[#2D2B4A] font-['Railway',ui-sans-serif,system-ui,sans-serif]">
  <% if notice.present? %>
    <div class="mb-8 rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-6 py-4 text-sm font-medium text-[#4C4682]">
      <%= notice %>
    </div>
  <% end %>

  <div class="mb-6 flex items-center justify-between">
    <h1 class="m-0 text-2xl font-semibold tracking-tight text-[#4C4682]">
      Pokemons
    </h1>
    <div>
      <%= link_to "New Pokemon", new_pokemon_path,
            class: "box-border inline-block rounded-lg bg-[#685FD6] px-[1.15rem] py-[0.65rem] text-sm font-medium text-white no-underline transition-all duration-200 ease-in-out hover:bg-[#554CBF]" %>
    </div>
  </div>

  <div id="pokemons">
    <% if @pokemons.any? %>
      <div class="mb-4 overflow-hidden rounded-xl border border-[#EAEFFC] bg-white shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr>
              <th class="border-b border-[#EAEFFC] bg-[#F8F9FE] px-6 py-4 text-xs font-semibold uppercase tracking-wider text-[#7973A8]">
                Pokemon Details
              </th>
              <th class="border-b border-[#EAEFFC] bg-[#F8F9FE] px-6 py-4 text-right text-xs font-semibold uppercase tracking-wider text-[#7973A8]">
                Actions
              </th>
            </tr>
          </thead>
          <tbody>
            <% @pokemons.each do |pokemon| %>
              <tr class="last:[&>td]:border-b-0">
                <td class="border-b border-[#EAEFFC] px-6 py-4 text-[0.9rem] text-[#2D2B4A]">
                  <%= render pokemon %>
                </td>
                <td class="border-b border-[#EAEFFC] px-6 py-4 text-right text-[0.9rem] text-[#2D2B4A]">
                  <%= link_to "View Details", pokemon,
                        class: "inline-block rounded-md bg-[#EEF0FD] px-[0.85rem] py-2 text-[0.8rem] font-medium text-[#685FD6] no-underline transition-all duration-200 ease-in-out hover:bg-[#685FD6] hover:text-white" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="px-2 text-right text-sm text-[#7973A8]">
        Showing <%= @pokemons.count %> pokemon
      </div>
    <% else %>
      <div class="rounded-xl border border-[#EAEFFC] bg-white px-8 py-16 text-center text-[0.95rem] text-[#7973A8] shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
        <p>No pokemon have been caught yet.</p>
        <%= link_to "Add First Pokemon", new_pokemon_path,
              class: "mt-6 box-border inline-block rounded-lg bg-[#685FD6] px-[1.15rem] py-[0.65rem] text-sm font-medium text-white no-underline transition-all duration-200 ease-in-out hover:bg-[#554CBF]" %>
      </div>
    <% end %>
  </div>
</div>