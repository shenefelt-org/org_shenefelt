<% content_for :title, "Pokemon Details" %>

<style>
  .show-wrapper {
    max-width: 600px;
    margin: 3rem auto;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #2D2B4A;
  }

  .flash-message {
    background: #F0F2FC;
    border: 1px solid #E0E3F6;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    color: #4C4682;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .card {
    background: #FFFFFF;
    padding: 2.5rem;
    border-radius: 12px;
    border: 1px solid #EAEFFC;
    box-shadow: 0 4px 20px rgba(104, 95, 214, 0.05);
    box-sizing: border-box;
  }

  .show-header {
    border-bottom: 1px solid #EAEFFC;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .show-title {
    margin: 0;
    color: #4C4682;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .pokemon-content {
    margin-bottom: 2.5rem;
  }

  /* Action Buttons */
  .action-group {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    border-top: 1px solid #EAEFFC;
    padding-top: 1.5rem;
  }

  .btn {
    display: inline-block;
    text-align: center;
    padding: 0.65rem 1.15rem;
    background: #685FD6;
    color: #FFFFFF;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    box-sizing: border-box;
    border: none;
    cursor: pointer;
  }

  .btn:hover {
    background: #554CBF;
  }

  .btn-secondary {
    display: inline-block;
    background: #EEF0FD;
    color: #685FD6;
    text-align: center;
    padding: 0.65rem 1.15rem;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .btn-secondary:hover {
    background: #685FD6;
    color: #FFFFFF;
  }

  .btn-danger {
    display: inline-block;
    background: #FFF0F0;
    color: #D32F2F;
    text-align: center;
    padding: 0.65rem 1.15rem;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .btn-danger:hover {
    background: #D32F2F;
    color: #FFFFFF;
  }

  /* Right-aligns the delete button in the flex row */
  .delete-form {
    margin-left: auto;
  }
</style>

<div class="show-wrapper">
  
  <% if notice.present? %>
    <div class="flash-message">
      <%= notice %>
    </div>
  <% end %>

  <div class="card">
    <div class="show-header">
      <h1 class="show-title">Pokemon Details</h1>
    </div>

    <div class="pokemon-content">
      <%# Renders your _pokemon.html.erb partial %>
      <%= render @pokemon %>
    </div>

    <div class="action-group">
      <%= link_to "Edit", edit_pokemon_path(@pokemon), class: "btn" %>
      <%= link_to "Back to Pokemons", pokemons_path, class: "btn-secondary" %>
      
      <%= button_to "Delete", @pokemon, method: :delete, class: "btn-danger", form_class: "delete-form", form: { data: { turbo_confirm: 'Are you sure you want to delete this Pokemon?' } } %>
    </div>
  </div>
</div>