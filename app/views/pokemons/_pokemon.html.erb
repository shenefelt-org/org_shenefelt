<div id="<%= dom_id pokemon %>">
  <div>
    <strong>Name:</strong>
    <%= pokemon.name %>
  </div>

  <div>
    <strong>Game idx:</strong>
    <%= pokemon.game_idx %>
  </div>

  <div>
    <strong>Url:</strong>
    <%= pokemon.url %>
  </div>

  <div>
    <strong>Sprite url:</strong>
    <%= pokemon.sprite_url %>
  </div>

  <div>
    <strong>Cry url:</strong>
    <%= pokemon.cry_url %>
  </div>

</div>
