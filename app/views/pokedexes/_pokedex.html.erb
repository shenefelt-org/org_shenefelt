<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>

<style>
  body {
    font-family: "Raleway", sans-serif;
    background-color: #f4f4f9; 
    display: flex;
    justify-content: center;
    padding: 2rem;
  }

  .pokedex-device {
    background-color: #DC0A2D;
    border-radius: 15px;
    padding: 20px;
    box-shadow: inset -5px -5px 10px rgba(0,0,0,0.2), 5px 5px 15px rgba(0,0,0,0.3);
    max-width: 350px;
    width: 100%;
    border: 2px solid #8b0000;
  }

  .pokedex-bezel {
    background-color: #dedede;
    border-radius: 10px;
    padding: 20px;
    border-bottom-left-radius: 40px; 
    box-shadow: inset 0 0 10px rgba(0,0,0,0.4);
  }

  .pokedex-screen {
    background-color: #f8f9fa;
    border: 3px solid #4C4682;
    border-radius: 5px;
    padding: 15px;
    color: #4C4682;
    box-shadow: inset 2px 2px 5px rgba(0,0,0,0.1);
  }

  .pokedex-sprite {
    text-align: center;
    background-color: #e2e8f0;
    border-radius: 5px;
    margin-bottom: 15px;
    padding: 10px;
    border: 2px solid #cbd5e1;
  }

  .pokedex-sprite img {
    width: 120px;
    height: 120px;
    image-rendering: pixelated; 
  }

  .pokedex-info-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid #4C4682;
    padding-bottom: 5px;
    margin-bottom: 15px;
  }

  .pokedex-name {
    font-size: 1.4rem;
    font-weight: 800;
    text-transform: capitalize;
  }

  .pokedex-id {
    font-weight: 700;
    font-size: 1.1rem;
    opacity: 0.8;
  }

  /* Updated: Clean, readable digital text instead of cursive */
  .pokedex-flavor {
    font-family: "Raleway", sans-serif;
    font-style: italic;
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1.6;
    background-color: rgba(76, 70, 130, 0.05);
    padding: 15px;
    border-radius: 5px;
    margin-bottom: 10px;
    border-left: 3px solid #4C4682; /* Added a small accent border to make it pop */
  }

  .pokedex-version {
    font-size: 0.75rem;
    text-align: right;
    font-weight: 700;
    text-transform: uppercase;
    opacity: 0.6;
  }
</style>

<div id="<%= dom_id pokedex %>" class="pokedex-device">
  <div class="pokedex-bezel">
    <div class="pokedex-screen">
      
      <div class="pokedex-sprite">
        <%= image_tag pokedex.pokemon.sprite_url, alt: pokedex.pokemon.name %>
      </div>

      <div class="pokedex-info-header">
        <div class="pokedex-name">
          <%= pokedex.pokemon.name %>
        </div>
        <div class="pokedex-id">
          No.<%= pokedex.pokemon.game_idx.to_s.rjust(3, '0') %>
        </div>
      </div>
      
      <div class="pokedex-flavor">
        "<%= pokedex.flavor_text %>"
      </div>

      <div class="pokedex-version">
        Data from: <%= pokedex.version_name %>
      </div>

    </div>
  </div>

  <%= audio_tag pokedex.pokemon.cry_url, controls: false, preload: "none", autoplay: true %>
</div>