<style>
  .pokedex-device {
    background: linear-gradient(135deg, #685FD6 0%, #4C4682 100%);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(104, 95, 214, 0.2);
    max-width: 360px;
    width: 100%;
    box-sizing: border-box;
    margin: 0 auto;
  }

  .pokedex-bezel {
    background-color: #F0F2FC;
    border-radius: 12px;
    padding: 16px;
    border-bottom-left-radius: 36px;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.06);
  }

  .pokedex-screen {
    background-color: #FFFFFF;
    border: 2px solid #E0E3F6;
    border-radius: 8px;
    padding: 16px;
    color: #2D2B4A;
  }

  .pokedex-sprite {
    text-align: center;
    background-color: #F8F9FE;
    border-radius: 8px;
    margin-bottom: 15px;
    padding: 12px;
    border: 1px solid #EAEFFC;
  }

  .pokedex-sprite img {
    width: 120px;
    height: 120px;
    image-rendering: pixelated; 
  }

  .pokedex-info-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid #EEF0FD;
    padding-bottom: 8px;
    margin-bottom: 12px;
  }

  .pokedex-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: #4C4682;
    text-transform: capitalize;
  }

  .pokedex-id {
    font-weight: 600;
    font-size: 0.9rem;
    color: #7973A8;
    font-family: 'Menlo', monospace, 'Courier New', Courier, monospace;
  }

  .pokedex-flavor {
    font-size: 0.9rem;
    line-height: 1.5;
    color: #4A4668;
    background-color: #F8F9FE;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 10px;
    border-left: 3px solid #685FD6;
    font-style: italic;
  }

  .pokedex-version {
    font-size: 0.75rem;
    text-align: right;
    font-weight: 600;
    text-transform: uppercase;
    color: #7973A8;
    letter-spacing: 0.03em;
  }
</style>

<div id="<%= dom_id pokedex %>" class="pokedex-device">
  <div class="pokedex-bezel">
    <div class="pokedex-screen">
      
      <% if pokedex.pokemon&.sprite_url.present? %>
        <div class="pokedex-sprite">
          <%= image_tag pokedex.pokemon.sprite_url, alt: pokedex.pokemon.name %>
        </div>
      <% end %>

      <div class="pokedex-info-header">
        <div class="pokedex-name">
          <%= pokedex.pokemon&.name || "Unknown" %>
        </div>
        <div class="pokedex-id">
          No.<%= pokedex.pokemon&.game_idx.to_s.rjust(3, '0') %>
        </div>
      </div>
      
      <div class="pokedex-flavor">
        "<%= pokedex.flavor_text || pokedex.flavor_text_entry %>"
      </div>

      <% if pokedex.version_name.present? %>
        <div class="pokedex-version">
          Data from: <%= pokedex.version_name %>
        </div>
      <% end %>

    </div>
  </div>

  <% if pokedex.pokemon&.cry_url.present? %>
    <%= audio_tag pokedex.pokemon.cry_url, controls: false, preload: "none", autoplay: true %>
  <% end %>
</div>