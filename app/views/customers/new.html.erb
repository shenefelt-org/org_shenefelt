<% content_for :title, "New Customer - SHENEFELT.ORG" %>

<div class="min-h-[calc(100vh-4rem)] bg-[#FAFBFD] px-6 py-10 font-sans text-[#2D2B4A]">
  <div class="mx-auto w-full max-w-[640px]">
    <div class="rounded-xl border border-[#EAEFFC] bg-white p-8 shadow-[0_4px_20px_rgba(104,95,214,0.05)] sm:p-10">
      <div class="mb-8 text-center">
        <h1 class="m-0 mb-1.5 text-2xl font-bold tracking-tight text-[#4C4682]">Add Customer</h1>
        <p class="m-0 text-sm font-medium text-[#7973A8]">Enter client details below to store their profile.</p>
      </div>

      <% if flash[:alert].present? %>
        <div class="mb-6 rounded-lg border border-red-300 bg-red-100 px-4 py-3 text-sm font-medium text-red-800">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with model: @customer, local: true, class: "space-y-5 text-left" do |f| %>
        <% if @customer.errors.any? %>
          <div class="rounded-lg border border-red-300 bg-red-100 px-4 py-3 text-sm text-red-800">
            <p class="mb-2 font-semibold">
              <%= pluralize(@customer.errors.count, "error") %> prevented this customer from being saved:
            </p>
            <ul class="m-0 list-disc space-y-1 pl-5">
              <% @customer.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= f.label :name, "Full Name", class: field_label_classes %>
            <%= f.text_field :name, required: true, class: field_input_classes, placeholder: "Jane Doe" %>
          </div>

          <div>
            <%= f.label :company_name, "Company Name", class: field_label_classes %>
            <%= f.text_field :company_name, class: field_input_classes, placeholder: "Acme Inc." %>
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= f.label :email, "Email Address", class: field_label_classes %>
            <%= f.email_field :email, class: field_input_classes, placeholder: "jane@example.com" %>
          </div>

          <div>
            <%= f.label :phone, "Phone Number", class: field_label_classes %>
            <%= f.telephone_field :phone, class: field_input_classes, placeholder: "(555) 000-0000" %>
          </div>
        </div>

        <div>
          <%= f.label :notes, "Notes", class: field_label_classes %>
          <%= f.text_area :notes, rows: 4, class: "#{field_input_classes} resize-y", placeholder: "Internal client notes..." %>
        </div>

        <div class="pt-2">
          <%= f.submit "Save Customer", class: "w-full cursor-pointer rounded-lg border-0 bg-[#685FD6] px-4 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-[#554CBF] focus:outline-none focus:ring-2 focus:ring-[#685FD6] focus:ring-offset-2" %>
        </div>
      <% end %>
    </div>
  </div>
</div>