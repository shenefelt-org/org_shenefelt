<% content_for :title, "Customers - SHENEFELT.ORG" %>

<div class="min-h-[calc(100vh-4rem)] bg-[#FAFBFD] px-6 py-10 font-sans text-[#2D2B4A]">
  <div class="mx-auto w-full max-w-[800px]">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="m-0 text-2xl font-bold tracking-tight text-[#4C4682]">Customers</h1>
        <p class="m-0 text-sm font-medium text-[#7973A8]">Manage customer records and contacts.</p>
      </div>
      <%= link_to "+ New Customer", new_customer_path, class: "rounded-lg bg-[#685FD6] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#554CBF]" %>
    </div>

    <% if flash[:notice].present? %>
      <div class="mb-6 rounded-lg border border-[#C7D2FE] bg-[#EEF0FD] px-4 py-3 text-sm font-medium text-[#4C4682]">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <div class="overflow-hidden rounded-xl border border-[#EAEFFC] bg-white shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
      <% if @customers.any? %>
        <div class="divide-y divide-[#EAEFFC]">
          <% @customers.each do |customer| %>
            <div class="flex items-center justify-between p-5 transition-colors hover:bg-[#FAFBFD]">
              <div>
                <h2 class="m-0 text-base font-semibold text-[#4C4682]">
                  <%= link_to customer.name, customer_path(customer), class: "hover:underline" %>
                </h2>
                <p class="m-0 text-xs text-[#7973A8]">
                  <%= [customer.company_name, customer.email, customer.phone].reject(&:blank?).join(" • ") %>
                </p>
              </div>
              <%= link_to "View", customer_path(customer), class: "text-xs font-semibold text-[#685FD6] hover:underline" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-8 text-center text-sm font-medium text-[#7973A8]">
          No customers recorded yet.
        </div>
      <% end %>
    </div>
  </div>
</div>