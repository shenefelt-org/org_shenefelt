<% content_for :title, "New Product - Portfolio" %>

<div class="min-h-[calc(100vh-4rem)] bg-[#FAFBFD] px-6 py-10 font-sans text-[#2D2B4A]">
  <div class="mx-auto w-full max-w-[640px]">
    <div class="rounded-xl border border-[#EAEFFC] bg-white p-8 shadow-[0_4px_20px_rgba(104,95,214,0.05)] sm:p-10">
      <div class="mb-8 text-center">
        <h1 class="m-0 mb-1.5 text-2xl font-bold tracking-tight text-[#4C4682]">
          Add New Product
        </h1>
      </div>

      <%= form_with model: @product, local: true, class: "space-y-5 text-left" do |f| %>
        <% 
          label_class = "block mb-1.5 text-sm font-semibold text-[#4C4682]"
          input_class = "block w-full rounded-lg border border-[#EAEFFC] bg-[#FAFBFD] px-4 py-2.5 text-sm text-[#2D2B4A] focus:border-[#685FD6] focus:outline-none focus:ring-1 focus:ring-[#685FD6]"
        %>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= f.label :title, "Product Title", class: label_class %>
            <%= f.text_field :title, required: true, class: input_class %>
          </div>

          <div>
            <%= f.label :price_in_cents, "Price (in cents)", class: label_class %>
            <%= f.number_field :price_in_cents, required: true, class: input_class %>
          </div>
        </div>

        <div>
          <%= f.label :description, "Description", class: label_class %>
          <%= f.text_area :description, rows: 4, required: true, class: "#{input_class} resize-y" %>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= f.label :stripe_product_id, "Stripe Product ID", class: label_class %>
            <%= f.text_field :stripe_product_id, class: input_class %>
          </div>

          <div>
            <%= f.label :stripe_price_id, "Stripe Price ID", class: label_class %>
            <%= f.text_field :stripe_price_id, class: input_class %>
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <%= f.check_box :active, class: "h-5 w-5 rounded border-[#EAEFFC] text-[#685FD6]" %>
          <%= f.label :active, "Active (Available for purchase)", class: "text-sm font-medium text-[#4C4682] m-0" %>
        </div>

        <div class="pt-4">
          <%= f.submit "Save Product", class: "w-full cursor-pointer rounded-lg border-0 bg-[#685FD6] px-4 py-3 text-sm font-semibold text-white hover:bg-[#554CBF]" %>
        </div>
      <% end %>
    </div>
  </div>
</div>