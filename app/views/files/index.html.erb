<style>
  .files-wrapper {
    max-width: 900px;
    margin: 2rem auto;
    padding: 2rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #2D2B4A;
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #EAEFFC;
    box-shadow: 0 4px 20px rgba(104, 95, 214, 0.05);
  }

  .files-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .files-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #4C4682;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header-nav form {
    display: inline;
    margin: 0;
  }

  .nav-btn {
    display: inline-block;
    padding: 0.45rem 0.85rem;
    font-size: 0.825rem;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
    font-family: inherit;
    box-sizing: border-box;
  }

  .nav-btn-home {
    background: #EEF0FD;
    color: #685FD6;
    border: 1px solid #E0E3F6;
  }

  .nav-btn-home:hover {
    background: #685FD6;
    color: #FFFFFF;
    border-color: #685FD6;
  }

  .nav-btn-logout {
    background: transparent;
    border: 1px solid #E0E3F6;
    color: #8C87B3;
    cursor: pointer;
  }

  .nav-btn-logout:hover {
    color: #685FD6;
    border-color: #C7D2FE;
    background: #EEF0FD;
  }

  .flash-message {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }
  .flash-alert {
    background: #FEE2E2;
    color: #991B1B;
    border: 1px solid #FCA5A5;
  }
  .flash-notice {
    background: #EEF0FD;
    color: #4C4682;
    border: 1px solid #C7D2FE;
  }

  .filter-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter-input {
    flex: 1;
    padding: 0.55rem 0.85rem;
    border: 1px solid #E0E3F6;
    border-radius: 8px;
    background: #F8F9FE;
    color: #2D2B4A;
    font-size: 0.875rem;
    outline: none;
    transition: all 0.2s ease;
  }

  .filter-input:focus {
    border-color: #8C82F2;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(140, 130, 242, 0.15);
  }

  .btn-filter {
    padding: 0.55rem 1.15rem;
    background: #685FD6;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-filter:hover {
    background: #554CBF;
  }

  .files-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.875rem;
  }

  .files-table th {
    padding: 0.75rem 0.85rem;
    font-weight: 600;
    color: #7973A8;
    border-bottom: 2px solid #EEF0FD;
    text-transform: uppercase;
    font-size: 0.725rem;
    letter-spacing: 0.05em;
  }

  .files-table td {
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid #F0F2FC;
    vertical-align: middle;
    color: #4A4668;
  }

  .files-table tr:hover {
    background: #FAFBFD;
  }

  .key-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.825rem;
    background: #F0F2FC;
    color: #4C4682;
    padding: 0.2rem 0.45rem;
    border-radius: 5px;
  }

  .action-btn {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: #685FD6;
    background: #EEF0FD;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    background: #685FD6;
    color: #FFFFFF;
  }

  .empty-state {
    padding: 2.5rem;
    text-align: center;
    color: #8C87B3;
    background: #F8F9FE;
    border-radius: 8px;
    border: 1px dashed #E0E3F6;
    font-size: 0.9rem;
  }

  .meta-count {
    margin-top: 1rem;
    font-size: 0.775rem;
    color: #8C87B3;
    text-align: right;
  }
</style>

<div class="files-wrapper">
  <div class="files-header">
    <h1 class="files-title">Files</h1>
    <div class="header-nav">
      <%= link_to "Home", root_path, class: "nav-btn nav-btn-home" %>
      <%= button_to "Log Out", logout_path, method: :delete, data: { turbo: false }, class: "nav-btn nav-btn-logout" %>
    </div>
  </div>

  <% if flash[:alert].present? %>
    <p class="flash-message flash-alert"><%= flash[:alert] %></p>
  <% end %>
  <% if flash[:notice].present? %>
    <p class="flash-message flash-notice"><%= flash[:notice] %></p>
  <% end %>

  <%= form_with url: files_path, method: :get, local: true, class: "filter-form" do %>
    <%= text_field_tag :prefix, @prefix, placeholder: "optional/prefix/", class: "filter-input" %>
    <%= submit_tag "Filter", class: "btn-filter" %>
  <% end %>

  <% if @files.blank? %>
    <div class="empty-state">
      <p style="margin: 0;">No objects found.</p>
    </div>
  <% else %>
    <table class="files-table">
      <thead>
        <tr>
          <th>Key</th>
          <th>Size</th>
          <th>Last modified</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @files.each do |f| %>
          <% key = f[:key].to_s %>
          <% folder = key.end_with?("/") %>
          <tr>
            <td><code class="key-code"><%= key %></code></td>
            <td><%= f[:size].present? ? number_to_human_size(f[:size].to_i) : "—" %></td>
            <td><%= f[:last_modified] || "—" %></td>
            <td style="text-align: right;">
              <% if folder %>
                <%= link_to "Open", files_path(prefix: key), class: "action-btn" %>
              <% else %>
                <%= link_to "Download",
                            download_files_path(key: key),
                            data: { turbo: false },
                            class: "action-btn" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="meta-count"><%= @files.size %> object(s)</p>
  <% end %>
</div>