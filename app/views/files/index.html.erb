<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-[900px] my-8 mx-auto p-8 font-sans text-[#2D2B4A] bg-white rounded-xl border border-[#EAEFFC] shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
  
  <!-- Header Section -->
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-semibold text-[#4C4682] m-0 tracking-tight">Files</h1>
    <div class="flex items-center gap-2">
      <%= button_to "Upload", new_file_path, method: :get, class: "inline-block px-3.5 py-2 text-[0.825rem] font-medium rounded-md no-underline transition-all duration-200 cursor-pointer bg-[#EEF0FD] text-[#685FD6] border border-[#E0E3F6] hover:bg-[#685FD6] hover:text-white hover:border-[#685FD6]" %>
    </div>
  </div>

  <!-- Flash Messages -->
  <% if flash[:alert].present? %>
    <p class="p-3 px-4 rounded-lg text-sm mb-5 bg-[#FEE2E2] text-[#991B1B] border border-[#FCA5A5]">
      <%= flash[:alert] %>
    </p>
  <% end %>

  <% if flash[:notice].present? %>
    <p class="p-3 px-4 rounded-lg text-sm mb-5 bg-[#EEF0FD] text-[#4C4682] border border-[#C7D2FE]">
      <%= flash[:notice] %>
    </p>
  <% end %>

  <!-- Filter Form -->
  <%= form_with url: files_path, method: :get, local: true, class: "flex gap-2 mb-6" do %>
    <%= text_field_tag :prefix,
      @prefix,
      placeholder: "optional/prefix/",
      class: "flex-1 px-3.5 py-2 border border-[#E0E3F6] rounded-lg bg-[#F8F9FE] text-[#2D2B4A] text-sm outline-none transition-all duration-200 focus:border-[#8C82F2] focus:bg-white focus:ring-4 focus:ring-[#8C82F2]/15" %>
    <%= submit_tag "Filter", class: "px-4.5 py-2 bg-[#685FD6] text-white border-0 rounded-lg font-medium text-sm cursor-pointer hover:bg-[#554CBF] transition-colors duration-200" %>
  <% end %>

  <!-- Content Table or Empty State -->
  <% if @files.blank? %>
    <div class="p-10 text-center text-[#8C87B3] bg-[#F8F9FE] rounded-lg border border-dashed border-[#E0E3F6] text-sm">
      <p class="m-0">No objects found.</p>
    </div>
  <% else %>
    <table class="w-full border-collapse text-left text-sm">
      <thead>
        <tr>
          <th class="px-3.5 py-3 font-semibold text-[#7973A8] border-b-2 border-[#EEF0FD] uppercase text-[0.725rem] tracking-wider">Key</th>
          <th class="px-3.5 py-3 font-semibold text-[#7973A8] border-b-2 border-[#EEF0FD] uppercase text-[0.725rem] tracking-wider">Size</th>
          <th class="px-3.5 py-3 font-semibold text-[#7973A8] border-b-2 border-[#EEF0FD] uppercase text-[0.725rem] tracking-wider">Last modified</th>
          <th class="px-3.5 py-3 border-b-2 border-[#EEF0FD]"></th>
        </tr>
      </thead>
      <tbody>
        <% @files.each do |f| %>
          <% key = f[:key].to_s %>
          <% folder = key.end_with?("/") %>
          <tr class="hover:bg-[#FAFBFD] transition-colors duration-150">
            <td class="px-3.5 py-3 border-b border-[#F0F2FC] align-middle text-[#4A4668]">
              <code class="font-mono text-[0.825rem] bg-[#F0F2FC] text-[#4C4682] px-2 py-1 rounded"><%= key %></code>
            </td>
            <td class="px-3.5 py-3 border-b border-[#F0F2FC] align-middle text-[#4A4668]">
              <%= f[:size].present? ? number_to_human_size(f[:size].to_i) : "-" %>
            </td>
            <td class="px-3.5 py-3 border-b border-[#F0F2FC] align-middle text-[#4A4668]">
              <%= f[:last_modified] || "-" %>
            </td>
            <td class="px-3.5 py-3 border-b border-[#F0F2FC] align-middle text-right">
              <% if folder %>
                <%= link_to "Open", files_path(prefix: key), class: "inline-block px-3 py-1 text-[0.8rem] font-medium text-[#685FD6] bg-[#EEF0FD] rounded-md no-underline border-0 cursor-pointer transition-all duration-200 hover:bg-[#685FD6] hover:text-white" %>
              <% else %>
                <%= link_to "Download",
                  download_files_path(key: key),
                  data: { turbo: false },
                  class: "inline-block px-3 py-1 text-[0.8rem] font-medium text-[#685FD6] bg-[#EEF0FD] rounded-md no-underline border-0 cursor-pointer transition-all duration-200 hover:bg-[#685FD6] hover:text-white" %>
              <% end %>

              <% if policy(:files).view_delete_button? %>
                <%= button_to "Delete",
                  files_path(key: key),
                  method: :delete,
                  form: { class: "inline m-0" },
                  data: { turbo_confirm: "Are you sure you want to delete #{key}?" },
                  class: "inline-block px-3 py-1 text-[0.8rem] font-medium bg-[#FFF0F0] text-[#D32F2F] rounded-md no-underline border-0 cursor-pointer transition-all duration-200 hover:bg-[#D32F2F] hover:text-white" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <p class="mt-4 text-[0.775rem] text-[#8C87B3] text-right"><%= @files.size %> files in /sad-wig</p>
  <% end %>
</div>