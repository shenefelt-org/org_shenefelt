<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-[1000px] my-8 mx-auto p-6 md:p-8 font-sans text-[#2D2B4A] bg-white rounded-xl border border-[#EAEFFC] shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
  
  <!-- Header Section -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-[#4C4682] m-0 tracking-tight">Contact Submissions</h1>
      <p class="text-sm text-[#7973A8] mt-1 m-0">Manage incoming messages and responses</p>
    </div>
    
    <% if @contacts.present? %>
      <div class="flex items-center gap-2.5">
        <div class="bg-[#F8F9FE] border border-[#E0E3F6] px-3.5 py-1.5 rounded-lg text-xs font-medium text-[#4C4682]">
          Total: <span class="font-bold text-[#685FD6]"><%= @contacts.size %></span>
        </div>
        <div class="bg-[#FEF3C7] border border-[#FDE68A] px-3.5 py-1.5 rounded-lg text-xs font-medium text-[#92400E]">
          Pending: <span class="font-bold text-[#B45309]"><%= @contacts.count { |c| !c.responded } %></span>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Flash Messages -->
  <% if flash[:alert].present? %>
    <p class="p-3 px-4 rounded-lg text-sm mb-5 bg-[#FEE2E2] text-[#991B1B] border border-[#FCA5A5]">
      <%= flash[:alert] %>
    </p>
  <% end %>

  <% if flash[:notice].present? %>
    <p class="p-3 px-4 rounded-lg text-sm mb-5 bg-[#EEF0FD] text-[#4C4682] border border-[#C7D2FE]">
      <%= flash[:notice] %>
    </p>
  <% end %>

  <!-- Submissions Table or Empty State -->
  <% if @contacts.blank? %>
    <div class="p-10 text-center text-[#8C87B3] bg-[#F8F9FE] rounded-lg border border-dashed border-[#E0E3F6] text-sm">
      <p class="m-0">No contact submissions found.</p>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm">
        <thead>
          <tr class="border-b-2 border-[#EEF0FD]">
            <th class="px-3.5 py-3 font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider w-12">ID</th>
            <th class="px-3.5 py-3 font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider">Sender</th>
            <th class="px-3.5 py-3 font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider">Message</th>
            <th class="px-3.5 py-3 font-semibold text-[#7973A8] uppercase text-[0.725rem] tracking-wider">Status</th>
            <th class="px-3.5 py-3 text-right"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#F0F2FC]">
          <% @contacts.each do |contact| %>
            <tr class="hover:bg-[#FAFBFD] transition-colors duration-150">
              
              <!-- ID -->
              <td class="px-3.5 py-4 align-top text-[#7973A8] font-mono text-xs">
                #<%= contact.id %>
              </td>

              <!-- Name & Email -->
              <td class="px-3.5 py-4 align-top whitespace-nowrap">
                <div class="font-semibold text-[#4C4682]"><%= contact.name %></div>
                <a href="mailto:<%= contact.email %>" class="text-xs text-[#685FD6] hover:underline transition-all">
                  <%= contact.email %>
                </a>
              </td>

              <!-- Message -->
              <td class="px-3.5 py-4 align-top max-w-xs text-[#4A4668]">
                <p class="m-0 line-clamp-2 text-sm leading-relaxed" title="<%= contact.message %>">
                  <%= contact.message %>
                </p>
              </td>

              <!-- Responded Status Badge -->
              <td class="px-3.5 py-4 align-top whitespace-nowrap">
                <% if contact.responded? %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-[#DCFCE7] text-[#166534] border border-[#BBF7D0]">
                    <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-[#16A34A]"></span>
                    Responded
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-[#FEF3C7] text-[#92400E] border border-[#FDE68A]">
                    <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-[#D97706]"></span>
                    Pending
                  </span>
                <% end %>
              </td>

              <!-- Actions -->
              <td class="px-3.5 py-4 align-top text-right whitespace-nowrap space-x-1">
                <%= link_to "View", contact_path(contact), class: "inline-block px-3 py-1 text-[0.8rem] font-medium text-[#685FD6] bg-[#EEF0FD] rounded-md no-underline transition-all duration-200 hover:bg-[#685FD6] hover:text-white" %>
                <%= link_to "Edit", edit_contact_path(contact), class: "inline-block px-3 py-1 text-[0.8rem] font-medium text-[#7973A8] bg-[#F0F2FC] rounded-md no-underline transition-all duration-200 hover:bg-[#685FD6] hover:text-white" %>
                <%= button_to "Delete", contact_path(contact), method: :delete, data: { turbo_confirm: "Delete this submission?" }, class: "inline-block px-2.5 py-1 text-[0.75rem] font-medium bg-[#FFF0F0] text-[#D32F2F] rounded-md border-0 cursor-pointer transition-all duration-200 hover:bg-[#D32F2F] hover:text-white", form: { class: "inline" } %>
              </td>

            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-[0.775rem] text-[#8C87B3] text-right">Showing <%= @contacts.size %> submission(s)</p>
  <% end %>
</div>