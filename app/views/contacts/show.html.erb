<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-[800px] my-8 mx-auto p-6 md:p-8 font-sans text-[#2D2B4A] bg-white rounded-xl border border-[#EAEFFC] shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 mb-6 border-b border-[#EEF0FD]">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-semibold text-[#4C4682] m-0 tracking-tight">
          Contact Submission #<%= @contact.id %>
        </h1>
        
        <!-- Status Badge -->
        <% if @contact.responded? %>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-[#DCFCE7] text-[#166534] border border-[#BBF7D0]">
            <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-[#16A34A]"></span>
            Responded
          </span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-[#FEF3C7] text-[#92400E] border border-[#FDE68A]">
            <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-[#D97706]"></span>
            Pending
          </span>
        <% end %>
      </div>
      <p class="text-sm text-[#7973A8] mt-1 m-0">Received submission details</p>
    </div>

    <%= link_to "← Back to Submissions", contacts_path, class: "text-xs font-medium text-[#685FD6] hover:underline no-underline" %>
  </div>

  <!-- Flash Messages -->
  <% if flash[:alert].present? %>
    <p class="p-3 px-4 rounded-lg text-sm mb-5 bg-[#FEE2E2] text-[#991B1B] border border-[#FCA5A5]">
      <%= flash[:alert] %>
    </p>
  <% end %>

  <% if flash[:notice].present? %>
    <p class="p-3 px-4 rounded-lg text-sm mb-5 bg-[#EEF0FD] text-[#4C4682] border border-[#C7D2FE]">
      <%= flash[:notice] %>
    </p>
  <% end %>

  <!-- Details Grid -->
  <div class="space-y-6">
    
    <!-- Sender Info Card -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 bg-[#F8F9FE] border border-[#E0E3F6] rounded-lg">
      <div>
        <span class="block text-[0.725rem] font-semibold uppercase text-[#7973A8] tracking-wider mb-1">Name</span>
        <span class="text-sm font-semibold text-[#4C4682]"><%= @contact.name %></span>
      </div>

      <div>
        <span class="block text-[0.725rem] font-semibold uppercase text-[#7973A8] tracking-wider mb-1">Email Address</span>
        <a href="mailto:<%= @contact.email %>" class="text-sm font-medium text-[#685FD6] hover:underline">
          <%= @contact.email %>
        </a>
      </div>
    </div>

    <!-- Message Content -->
    <div>
      <span class="block text-[0.725rem] font-semibold uppercase text-[#7973A8] tracking-wider mb-2">Message Content</span>
      <div class="p-5 bg-[#F8F9FE] border border-[#E0E3F6] rounded-lg text-sm text-[#2D2B4A] leading-relaxed whitespace-pre-wrap font-sans">
        <%= @contact.message %>
      </div>
    </div>

  </div>

  <!-- Footer Actions -->
  <div class="flex justify-between items-center pt-6 mt-8 border-t border-[#EEF0FD]">
    <%= link_to "Back to Index", contacts_path, class: "px-4 py-2 text-sm font-medium text-[#7973A8] bg-[#F0F2FC] rounded-lg hover:bg-[#E0E3F6] transition-colors no-underline" %>
    
    <div class="flex items-center gap-2">
      <%= link_to "Edit Submission", edit_contact_path(@contact), class: "px-4 py-2 text-sm font-medium text-white bg-[#685FD6] rounded-lg hover:bg-[#554CBF] transition-colors no-underline" %>
      <%= button_to "Delete", contact_path(@contact), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this submission?" }, class: "px-4 py-2 text-sm font-medium bg-[#FFF0F0] text-[#D32F2F] rounded-lg border-0 cursor-pointer transition-all duration-200 hover:bg-[#D32F2F] hover:text-white" %>
    </div>
  </div>

</div>