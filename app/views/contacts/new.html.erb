<% content_for :title, "Contact Us - Shenefelt" %>

<div class="box-border flex min-h-[calc(100vh-70px)] items-center justify-center p-8 font-['Railway',ui-sans-serif,system-ui,sans-serif]">
  <div class="box-border w-full max-w-[420px] rounded-xl border border-[#EAEFFC] bg-white p-10 shadow-[0_4px_20px_rgba(104,95,214,0.05)]">

    <h2 class="m-0 mb-1 text-2xl font-semibold tracking-tight text-[#4C4682]">
      Say Hi!
    </h2>
    <p class="mb-5 mt-0 text-xs text-[#7973A8]">
      Send a message or schedule a call below.
    </p>

    <% if notice %>
      <div class="mb-5 rounded-lg border border-[#E0E3F6] bg-[#EEF0FD] p-3 text-[0.825rem] text-[#685FD6]">
        <%= notice %>
      </div>
    <% end %>

    <%= form_with model: @contact, url: contacts_path do |f| %>
      <% if @contact.errors.any? %>
        <div class="mb-4 text-[0.825rem] text-[#D93838]">
          <ul class="m-0 list-inside list-disc space-y-0.5 pl-2">
            <% @contact.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-4">
        <%= f.label :name, "name",
              class: "mb-1.5 block text-[0.825rem] font-medium text-[#4C4682]" %>
        <%= f.text_field :name,
              required: true,
              class: "w-full rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-3.5 py-2.5 font-['Railway',ui-sans-serif,system-ui,sans-serif] text-[0.825rem] text-[#4C4682] outline-none transition-colors duration-200 focus:border-[#685FD6]" %>
      </div>

      <div class="mb-4">
        <%= f.label :email, "email",
              class: "mb-1.5 block text-[0.825rem] font-medium text-[#4C4682]" %>
        <%= f.email_field :email,
              required: true,
              class: "w-full rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-3.5 py-2.5 font-['Railway',ui-sans-serif,system-ui,sans-serif] text-[0.825rem] text-[#4C4682] outline-none transition-colors duration-200 focus:border-[#685FD6]" %>
      </div>

      <div class="mb-4">
        <%= f.label :message, "message",
              class: "mb-1.5 block text-[0.825rem] font-medium text-[#4C4682]" %>
        <%= f.text_area :message,
              rows: 4,
              required: true,
              class: "w-full rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-3.5 py-2.5 font-['Railway',ui-sans-serif,system-ui,sans-serif] text-[0.825rem] text-[#4C4682] outline-none transition-colors duration-200 focus:border-[#685FD6]" %>
      </div>

      <%= f.submit "Send Message",
            class: "mt-5 block w-full cursor-pointer rounded-lg border-0 bg-[#685FD6] px-4 py-2.5 text-center text-sm font-medium text-white transition-colors duration-200 font-['Railway',ui-sans-serif,system-ui,sans-serif] hover:bg-[#554CBF]" %>
    <% end %>

    <div class="relative my-6 text-center">
      <div class="absolute inset-0 flex items-center">
        <div class="w-full border-t border-[#EAEFFC]"></div>
      </div>
      <span class="relative bg-white px-3 text-xs text-[#7973A8]">or</span>
    </div>

    <a href="https://calendar.app.google/gkrRmTXPfUFEPbTy9"
       target="_blank"
       rel="noopener noreferrer"
       class="block w-full rounded-lg border border-[#E0E3F6] bg-[#F0F2FC] px-4 py-2.5 text-center text-xs font-medium text-[#685FD6] no-underline transition-all duration-200 hover:border-[#685FD6] hover:bg-[#685FD6] hover:text-white">
      Schedule with Me
    </a>
  </div>
</div>