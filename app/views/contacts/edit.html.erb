<!-- Tailwind CSS CDN -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-[650px] my-8 mx-auto p-6 md:p-8 font-sans text-[#2D2B4A] bg-white rounded-xl border border-[#EAEFFC] shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
  
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-[#4C4682] m-0 tracking-tight">Edit Contact #<%= @contact.id %></h1>
      <p class="text-sm text-[#7973A8] mt-1 m-0">Update message details and mark as responded</p>
    </div>
    <%= link_to "Back to Submissions", contacts_path, class: "text-xs font-medium text-[#685FD6] hover:underline" %>
  </div>

  <%= form_with(model: @contact, local: true, class: "space-y-5") do |f| %>
    
    <% if @contact.errors.any? %>
      <div class="p-4 rounded-lg bg-[#FEE2E2] border border-[#FCA5A5] text-sm text-[#991B1B]">
        <h2 class="font-semibold mb-1"><%= pluralize(@contact.errors.count, "error") %> prohibited this contact from being saved:</h2>
        <ul class="list-disc list-inside m-0 space-y-0.5">
          <% @contact.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-xs font-semibold uppercase text-[#7973A8] tracking-wider mb-1.5" %>
      <%= f.text_field :name, class: "w-full px-3.5 py-2 border border-[#E0E3F6] rounded-lg bg-[#F8F9FE] text-[#2D2B4A] text-sm outline-none transition-all focus:border-[#8C82F2] focus:bg-white focus:ring-4 focus:ring-[#8C82F2]/15" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-xs font-semibold uppercase text-[#7973A8] tracking-wider mb-1.5" %>
      <%= f.email_field :email, class: "w-full px-3.5 py-2 border border-[#E0E3F6] rounded-lg bg-[#F8F9FE] text-[#2D2B4A] text-sm outline-none transition-all focus:border-[#8C82F2] focus:bg-white focus:ring-4 focus:ring-[#8C82F2]/15" %>
    </div>

    <div>
      <%= f.label :message, class: "block text-xs font-semibold uppercase text-[#7973A8] tracking-wider mb-1.5" %>
      <%= f.text_area :message, rows: 5, class: "w-full px-3.5 py-2 border border-[#E0E3F6] rounded-lg bg-[#F8F9FE] text-[#2D2B4A] text-sm outline-none transition-all focus:border-[#8C82F2] focus:bg-white focus:ring-4 focus:ring-[#8C82F2]/15" %>
    </div>

    <!-- Responded Status Checkbox -->
    <div class="pt-2">
      <label class="flex items-center gap-3 p-3.5 bg-[#F8F9FE] border border-[#E0E3F6] rounded-lg cursor-pointer hover:bg-[#EEF0FD] transition-colors">
        <%= f.check_box :responded, class: "w-4 h-4 text-[#685FD6] border-[#E0E3F6] rounded focus:ring-[#8C82F2]" %>
        <div>
          <span class="block text-sm font-semibold text-[#4C4682]">Mark as Responded</span>
          <span class="block text-xs text-[#7973A8]">Check this box if you have replied to this submission</span>
        </div>
      </label>
    </div>

    <div class="flex justify-end gap-3 pt-4 border-t border-[#EEF0FD]">
      <%= link_to "Cancel", contacts_path, class: "px-4 py-2 text-sm font-medium text-[#7973A8] bg-[#F0F2FC] rounded-lg hover:bg-[#E0E3F6] transition-colors no-underline" %>
      <%= f.submit "Update Submission", class: "px-5 py-2 bg-[#685FD6] text-white border-0 rounded-lg font-medium text-sm cursor-pointer hover:bg-[#554CBF] transition-colors" %>
    </div>

  <% end %>
</div>