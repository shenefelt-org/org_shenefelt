<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center bg-[#F8F9FE] px-4 py-10 text-[#2D2B4A]">
  <div class="w-full max-w-[380px] rounded-xl border border-[#EAEFFC] bg-white p-10 text-center shadow-[0_4px_20px_rgba(104,95,214,0.05)]">
    <h1 class="m-0 mb-1.5 text-2xl font-semibold tracking-tight text-[#4C4682]">
      Sign In
    </h1>

    <p class="mb-7 mt-0 text-sm text-[#7973A8]">
      Validate with SSO
    </p>

    <% if flash[:alert].present? %>
      <p class="mb-5 rounded-lg border border-red-300 bg-red-100 px-4 py-3 text-left text-sm text-red-800">
        <%= flash[:alert] %>
      </p>
    <% end %>

    <% if flash[:notice].present? %>
      <p class="mb-5 rounded-lg border border-indigo-200 bg-[#EEF0FD] px-4 py-3 text-left text-sm text-[#4C4682]">
        <%= flash[:notice] %>
      </p>
    <% end %>

    <%= link_to "SSO Auth Gateway",
          openid_connect_path,
          class: "block w-full rounded-lg bg-[#685FD6] px-4 py-3 text-sm font-medium text-white no-underline transition-colors hover:bg-[#554CBF]",
          data: { turbo: false } %>
  </div>
</div>