<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SHENEFELT.ORG" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Org Shenefelt">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <!-- 1. Google Font: Raleway -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <!-- 2. Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 3. Configure Tailwind to use Raleway as default font-sans -->
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Raleway', 'sans-serif'],
            }
          }
        }
      }
    </script>
    <%# Safe check for Pokemon sprite favicon %>
    <% sprite_url = (get_random_sprite_url rescue nil) %>
    <% if sprite_url.present? %>
      <%= favicon_link_tag sprite_url %>
    <% end %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "login", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="font-sans bg-[#FAFBFD] text-[#2D2B4A]">
    <!-- Site Navbar -->
    <nav class="bg-white border-b border-[#EAEFFC] shadow-[0_4px_20px_rgba(104,95,214,0.05)] sticky top-0 z-[100] font-sans" data-controller="mobile-menu">
      <div class="max-w-[1000px] mx-auto px-6 h-16 flex justify-between items-center">
        <%# Left side: Brand / Logo %>
        <div class="flex items-center h-full">
          <%= link_to "button box", root_path, class: "text-[#4C4682] hover:text-[#685FD6] text-xl font-bold tracking-tight transition-colors duration-200 no-underline leading-none flex items-center" %>
        </div>
        <%# Mobile Hamburger Toggle Button %>
        <button id="mobile-menu-button" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')" type="button" class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-[#7973A8] hover:text-[#685FD6] hover:bg-[#F0F2FC] focus:outline-none" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <%# Desktop Menu %>
        <div class="hidden md:flex items-center gap-6 h-full">
          <% unless current_page?(quotes_path) %>
            <%= link_to "Quotes", quotes_path, class: "text-[#7973A8] hover:text-[#685FD6] text-sm font-semibold transition-colors duration-200 no-underline flex items-center h-full" %>
          <% end %>
          <% unless request.path == "/customers" %>
            <%= link_to "Customers", "/customers", class: "text-[#7973A8] hover:text-[#685FD6] text-sm font-semibold transition-colors duration-200 no-underline flex items-center h-full" %>
          <% end %>
          <% unless authenticated? %>
            <% unless current_page?(root_path) %>
              <%= link_to "About Me", root_path, class: "text-[#7973A8] hover:text-[#685FD6] text-sm font-semibold transition-colors duration-200 no-underline flex items-center h-full" %>
            <% end %>
            <!-- Portfolio Dropdown Menu -->
            <div class="relative group flex items-center h-full cursor-pointer">
              <span class="text-[#7973A8] group-hover:text-[#685FD6] text-sm font-semibold transition-colors duration-200 flex items-center">
                Portfolio
              </span>
              <svg width="14" height="14" class="w-3.5 h-3.5 ml-1 text-[#7973A8] group-hover:text-[#685FD6] transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
              <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50">
                <div class="bg-white border border-[#EAEFFC] rounded-md shadow-lg py-1 min-w-[180px]">
                  <% unless current_page?(portfolio_path) %>
                    <%= link_to "All Projects", portfolio_path, class: "block px-4 py-2 text-sm text-[#7973A8] hover:text-[#685FD6] hover:bg-[#F0F2FC] font-medium transition-colors duration-200 no-underline" %>
                  <% end %>
                  <% unless current_page?(pokemons_path) %>
                    <%= link_to "Pokemon Info", pokemons_path, class: "block px-4 py-2 text-sm text-[#7973A8] hover:text-[#685FD6] hover:bg-[#F0F2FC] font-medium transition-colors duration-200 no-underline" %>
                  <% end %>
                  <% unless current_page?(ip_path) %>
                    <%= link_to "Public IP", ip_path, class: "block px-4 py-2 text-sm text-[#7973A8] hover:text-[#685FD6] hover:bg-[#F0F2FC] font-medium transition-colors duration-200 no-underline" %>
                  <% end %>
                  <% unless current_page?(funko_pops_path) %>
                    <%= link_to "Funko Collection", funko_pops_path, class: "block px-4 py-2 text-sm text-[#7973A8] hover:text-[#685FD6] hover:bg-[#F0F2FC] font-medium transition-colors duration-200 no-underline" %>
                  <% end %>
                  <% can_view_files = (policy(:files).view_files_button? rescue true) %>
                  <% if can_view_files %>
                    <% unless current_page?(files_path) %>
                      <%= link_to "Files", files_path, class: "block px-4 py-2 text-sm text-[#7973A8] hover:text-[#685FD6] hover:bg-[#F0F2FC] font-medium transition-colors duration-200 no-underline" %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
          <% if authenticated? %>
            <% unless request.path == "/shop" %>
              <%= link_to "Shop", "/shop", class: "text-[#7973A8] hover:text-[#685FD6] text-sm font-semibold transition-colors duration-200 no-underline flex items-center h-full" %>
            <% end %>
            <% unless request.path == "/orders" %>
              <%= link_to "Orders", "/orders", class: "text-[#7973A8] hover:text-[#685FD6] text-sm font-semibold transition-colors duration-200 no-underline flex items-center h-full" %>
            <% end %>
          <% end %>
          <% unless current_page?(new_contact_path) %>
            <%= link_to "Contact Me", new_contact_path, class: "text-[#7973A8] hover:text-[#685FD6] text-sm font-semibold transition-colors duration-200 no-underline flex items-center h-full" %>
          <% end %>
          <div class="w-px h-6 bg-[#EAEFFC] self-center"></div>
          <% active_usr = current_user || (defined?(Current) && Current.user) %>
          <% if active_usr.present? %>
            <% current_user_email = active_usr.try(:email_address) || active_usr.try(:email) %>
            <% if current_user_email.present? %>
              <span class="bg-[#F0F2FC] border border-[#E0E3F6] px-3 py-1.5 rounded-md text-xs text-[#4C4682] font-semibold flex items-center self-center">
                <%= current_user_email %>
              </span>
            <% end %>
            <%= button_to "Log Out", logout_path, method: :delete, class: "bg-transparent border-0 text-[#8C87B3] hover:text-[#685FD6] text-[0.85rem] font-semibold p-0 transition-colors duration-200 cursor-pointer flex items-center h-full", form_class: "m-0 flex items-center h-full" %>
          <% else %>
            <%= link_to "Log In", login_path, class: "text-[#685FD6] hover:text-[#4C4682] text-sm font-semibold transition-colors duration-200 no-underline flex items-center h-full" %>
          <% end %>
        </div>
      </div>
      <%# Mobile Menu Panel %>
      <div class="hidden md:hidden bg-white border-b border-[#EAEFFC] px-6 pt-2 pb-4 space-y-3" id="mobile-menu">
        <% unless current_page?(quotes_path) %>
          <%= link_to "Quotes", quotes_path, class: "block text-[#7973A8] hover:text-[#685FD6] text-base font-semibold transition-colors duration-200 no-underline py-1" %>
        <% end %>
        <% unless request.path == "/customers" %>
          <%= link_to "Customers", "/customers", class: "block text-[#7973A8] hover:text-[#685FD6] text-base font-semibold transition-colors duration-200 no-underline py-1" %>
        <% end %>
        <% unless authenticated? %>
          <% unless current_page?(root_path) %>
            <%= link_to "About Me", root_path, class: "block text-[#7973A8] hover:text-[#685FD6] text-base font-semibold transition-colors duration-200 no-underline py-1" %>
          <% end %>
          <!-- Mobile Portfolio Section -->
          <div class="space-y-1">
            <span class="block text-xs font-bold text-[#8C87B3] uppercase tracking-wider py-1">Portfolio</span>
            <% unless current_page?(portfolio_path) %>
              <%= link_to "All Projects", portfolio_path, class: "block pl-3 py-1 text-sm text-[#7973A8] hover:text-[#685FD6] font-medium no-underline" %>
            <% end %>
            <% unless current_page?(pokemons_path) %>
              <%= link_to "Pokemon Info", pokemons_path, class: "block pl-3 py-1 text-sm text-[#7973A8] hover:text-[#685FD6] font-medium no-underline" %>
            <% end %>
            <% unless current_page?(ip_path) %>
              <%= link_to "Public IP", ip_path, class: "block pl-3 py-1 text-sm text-[#7973A8] hover:text-[#685FD6] font-medium no-underline" %>
            <% end %>
            <% unless current_page?(funko_pops_path) %>
              <%= link_to "Funko Collection", funko_pops_path, class: "block pl-3 py-1 text-sm text-[#7973A8] hover:text-[#685FD6] font-medium no-underline" %>
            <% end %>
            <% can_view_files = (policy(:files).view_files_button? rescue true) %>
            <% if can_view_files %>
              <% unless current_page?(files_path) %>
                <%= link_to "Files", files_path, class: "block pl-3 py-1 text-sm text-[#7973A8] hover:text-[#685FD6] font-medium no-underline" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <% if authenticated? %>
          <div class="space-y-1">
            <span class="block text-xs font-bold text-[#8C87B3] uppercase tracking-wider py-1">Shop</span>
            <% unless request.path == "/shop" %>
              <%= link_to "Shop", "/shop", class: "block pl-3 py-1 text-sm text-[#7973A8] hover:text-[#685FD6] font-medium no-underline" %>
            <% end %>
            <% unless request.path == "/orders" %>
              <%= link_to "Orders", "/orders", class: "block pl-3 py-1 text-sm text-[#7973A8] hover:text-[#685FD6] font-medium no-underline" %>
            <% end %>
          </div>
        <% end %>
        <% unless current_page?(new_contact_path) %>
          <%= link_to "Contact Me", new_contact_path, class: "block text-[#7973A8] hover:text-[#685FD6] text-base font-semibold transition-colors duration-200 no-underline py-1" %>
        <% end %>
        <div class="pt-2 border-t border-[#EAEFFC]">
          <% active_usr = current_user || (defined?(Current) && Current.user) %>
          <% if active_usr.present? %>
            <% current_user_email = active_usr.try(:email_address) || active_usr.try(:email) %>
            <% if current_user_email.present? %>
              <div class="mb-2 text-xs text-[#4C4682] font-semibold bg-[#F0F2FC] p-2 rounded-md inline-block">
                <%= current_user_email %>
              </div>
            <% end %>
            <%= button_to "Log Out", logout_path, method: :delete, class: "block text-[#8C87B3] hover:text-[#685FD6] text-base font-semibold transition-colors duration-200 cursor-pointer bg-transparent border-0 p-0" %>
          <% else %>
            <%= link_to "Log In", login_path, class: "block text-[#685FD6] hover:text-[#4C4682] text-base font-semibold transition-colors duration-200 no-underline py-1" %>
          <% end %>
        </div>
      </div>
    </nav>
    <%= yield %>
  </body>
</html>