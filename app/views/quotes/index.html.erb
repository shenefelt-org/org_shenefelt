<div class="max-w-[1000px] mx-auto px-6 py-10">
  <%# Page Header %>
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-[#4C4682]">Quotes</h1>
      <p class="text-sm text-[#8C87B3] mt-1">Manage and view all quotes</p>
    </div>
    <%= link_to "New Quote", new_quote_path, class: "bg-[#685FD6] hover:bg-[#4C4682] text-white text-sm font-semibold px-5 py-2.5 rounded-md no-underline transition-colors duration-200 inline-flex items-center gap-2" %>
  </div>

  <% if @quotes.any? %>
    <%# Quotes Table (Desktop) %>
    <div class="hidden md:block bg-white border border-[#EAEFFC] rounded-lg shadow-[0_4px_20px_rgba(104,95,214,0.05)] overflow-hidden">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-[#F0F2FC] text-[#4C4682]">
            <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider">Quote #</th>
            <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider">Approved</th>
            <th class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#EAEFFC]">
          <% @quotes.each do |quote| %>
            <tr class="hover:bg-[#F0F2FC] transition-colors duration-150">
              <td class="px-5 py-4 text-sm font-semibold text-[#4C4682]">
                <%= link_to quote.quote_number, quote_path(quote), class: "hover:text-[#685FD6] no-underline transition-colors duration-200" %>
              </td>
              <td class="px-5 py-4">
                <% if quote.approved? %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-green-50 border border-green-200 text-green-700">
                    Approved
                  </span>
                <% else %>
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[#F0F2FC] border border-[#E0E3F6] text-[#4C4682]">
                    Pending
                  </span>
                <% end %>
              </td>
              <td class="px-5 py-4 text-right space-x-3 whitespace-nowrap">
                <%= link_to "View", quote_path(quote), class: "text-[#685FD6] hover:text-[#4C4682] text-sm font-semibold no-underline transition-colors duration-200" %>
                <%= link_to "Edit", edit_quote_path(quote), class: "text-[#685FD6] hover:text-[#4C4682] text-sm font-semibold no-underline transition-colors duration-200" %>
                <%= button_to "Delete", quote_path(quote), method: :delete, form_class: "inline-block", class: "text-[#8C87B3] hover:text-red-500 text-sm font-semibold bg-transparent border-0 p-0 cursor-pointer transition-colors duration-200", data: { turbo_confirm: "Are you sure you want to delete this quote?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Quotes Cards (Mobile) %>
    <div class="md:hidden space-y-4">
      <% @quotes.each do |quote| %>
        <div class="bg-white border border-[#EAEFFC] rounded-lg shadow-[0_4px_20px_rgba(104,95,214,0.05)] p-5">
          <div class="flex justify-between items-start mb-3">
            <%= link_to quote.quote_number, quote_path(quote), class: "text-base font-bold text-[#4C4682] hover:text-[#685FD6] no-underline transition-colors duration-200" %>
            <% if quote.approved? %>
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-green-50 border border-green-200 text-green-700">
                Approved
              </span>
            <% else %>
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[#F0F2FC] border border-[#E0E3F6] text-[#4C4682]">
                Pending
              </span>
            <% end %>
          </div>
          <div class="flex items-center gap-4 pt-3 border-t border-[#EAEFFC]">
            <%= link_to "View", quote_path(quote), class: "text-[#685FD6] hover:text-[#4C4682] text-sm font-semibold no-underline transition-colors duration-200" %>
            <%= link_to "Edit", edit_quote_path(quote), class: "text-[#685FD6] hover:text-[#4C4682] text-sm font-semibold no-underline transition-colors duration-200" %>
            <%= button_to "Delete", quote_path(quote), method: :delete, form_class: "inline-block", class: "text-[#8C87B3] hover:text-red-500 text-sm font-semibold bg-transparent border-0 p-0 cursor-pointer transition-colors duration-200", data: { turbo_confirm: "Are you sure you want to delete this quote?" } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Empty State %>
    <div class="bg-white border border-[#EAEFFC] rounded-lg shadow-[0_4px_20px_rgba(104,95,214,0.05)] py-16 px-6 text-center">
      <svg class="w-14 h-14 mx-auto mb-4 text-[#E0E3F6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <h2 class="text-lg font-bold text-[#4C4682] mb-1">No quotes yet</h2>
      <p class="text-sm text-[#8C87B3] mb-6">Get started by creating your first quote.</p>
      <%= link_to "New Quote", new_quote_path, class: "bg-[#685FD6] hover:bg-[#4C4682] text-white text-sm font-semibold px-5 py-2.5 rounded-md no-underline transition-colors duration-200 inline-block" %>
    </div>
  <% end %>
</div>