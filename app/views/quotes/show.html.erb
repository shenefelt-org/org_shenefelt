<div class="max-w-[1000px] mx-auto px-6 py-10">
  <%# Breadcrumb / Back Link %>
  <div class="mb-6">
    <%= link_to "← Back to Quotes", quotes_path, class: "text-sm font-semibold text-[#7973A8] hover:text-[#685FD6] no-underline transition-colors duration-200 inline-flex items-center gap-1" %>
  </div>

  <%# Quote Card %>
  <div class="bg-white border border-[#EAEFFC] rounded-lg shadow-[0_4px_20px_rgba(104,95,214,0.05)] overflow-hidden">
    <%# Card Header %>
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 px-6 py-5 bg-[#F0F2FC] border-b border-[#EAEFFC]">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-[#4C4682]">
          Quote <%= @quote.quote_number %>
        </h1>
        <p class="text-xs text-[#8C87B3] mt-1">
          Created <%= time_ago_in_words(@quote.created_at) %> ago
        </p>
      </div>
      <% if @quote.approved? %>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-green-50 border border-green-200 text-green-700 self-start sm:self-center">
          Approved
        </span>
      <% else %>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-[#F0F2FC] border border-[#E0E3F6] text-[#4C4682] self-start sm:self-center">
          Pending
        </span>
      <% end %>
    </div>

    <%# Details Section %>
    <div class="px-6 py-6">
      <h2 class="text-xs font-bold text-[#8C87B3] uppercase tracking-wider mb-4">Details</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
        <div class="flex flex-col">
          <dt class="text-xs font-semibold text-[#8C87B3] uppercase tracking-wider">Quote Number</dt>
          <dd class="text-sm font-semibold text-[#2D2B4A] mt-1"><%= @quote.quote_number %></dd>
        </div>
        <div class="flex flex-col">
          <dt class="text-xs font-semibold text-[#8C87B3] uppercase tracking-wider">Status</dt>
          <dd class="text-sm font-semibold text-[#2D2B4A] mt-1">
            <%= @quote.approved? ? "Approved" : "Pending" %>
          </dd>
        </div>
        <div class="flex flex-col">
          <dt class="text-xs font-semibold text-[#8C87B3] uppercase tracking-wider">Created</dt>
          <dd class="text-sm font-semibold text-[#2D2B4A] mt-1">
            <%= @quote.created_at.strftime("%B %d, %Y %I:%M %p") %>
          </dd>
        </div>
        <div class="flex flex-col">
          <dt class="text-xs font-semibold text-[#8C87B3] uppercase tracking-wider">Last Updated</dt>
          <dd class="text-sm font-semibold text-[#2D2B4A] mt-1">
            <%= @quote.updated_at.strftime("%B %d, %Y %I:%M %p") %>
          </dd>
        </div>
      </dl>
    </div>

    <%# Actions Footer %>
    <div class="px-6 py-4 bg-[#FAFBFD] border-t border-[#EAEFFC] flex flex-col sm:flex-row gap-3 sm:justify-end">
      <%= link_to "Edit", edit_quote_path(@quote), class: "bg-[#685FD6] hover:bg-[#4C4682] text-white text-sm font-semibold px-5 py-2.5 rounded-md no-underline transition-colors duration-200 text-center" %>
      <%= button_to "Delete", quote_path(@quote), method: :delete, class: "bg-white border border-[#E0E3F6] hover:border-red-300 text-[#8C87B3] hover:text-red-500 text-sm font-semibold px-5 py-2.5 rounded-md cursor-pointer transition-colors duration-200", data: { turbo_confirm: "Are you sure you want to delete this quote?" } %>
    </div>
  </div>
</div>