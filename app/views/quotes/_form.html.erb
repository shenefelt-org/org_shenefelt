<%= form_with model: quote do |f| %>
  <%# Show validation errors if any %>
  <% if quote.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-md px-4 py-3 mb-6">
      <h2 class="text-sm font-bold text-red-700 mb-1">
        <%= pluralize(quote.errors.count, "error") %> prevented this quote from being saved:
      </h2>
      <ul class="text-sm text-red-600 list-disc list-inside">
        <% quote.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-5">
    <%# Quote Number %>
    <div class="flex flex-col">
      <%= f.label :quote_num, "Quote Number", class: "text-xs font-semibold text-[#8C87B3] uppercase tracking-wider mb-2" %>
      <%= f.text_field :quote_num, class: "bg-white border border-[#E0E3F6] rounded-md px-4 py-2.5 text-sm text-[#2D2B4A] focus:outline-none focus:border-[#685FD6] focus:ring-2 focus:ring-[#685FD6]/20 transition-colors duration-200", placeholder: "e.g. Q-2026-001" %>
    </div>

    <%# Approved %>
    <div class="flex items-center gap-3 bg-[#F0F2FC] border border-[#E0E3F6] rounded-md px-4 py-3">
      <%= f.check_box :approved, class: "h-4 w-4 accent-[#685FD6] cursor-pointer" %>
      <%= f.label :approved, "Approved", class: "text-sm font-semibold text-[#4C4682] cursor-pointer" %>
    </div>
  </div>

  <%# Submit / Cancel %>
  <div class="flex flex-col sm:flex-row gap-3 sm:justify-end mt-8 pt-5 border-t border-[#EAEFFC]">
    <%= link_to "Cancel", quotes_path, class: "bg-white border border-[#E0E3F6] hover:border-[#685FD6] text-[#7973A8] hover:text-[#685FD6] text-sm font-semibold px-5 py-2.5 rounded-md no-underline transition-colors duration-200 text-center" %>
    <%= f.submit quote.new_record? ? "Create Quote" : "Update Quote", class: "bg-[#685FD6] hover:bg-[#4C4682] text-white text-sm font-semibold px-5 py-2.5 rounded-md cursor-pointer transition-colors duration-200" %>
  </div>
<% end %>