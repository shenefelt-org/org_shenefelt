<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-2xl mx-auto my-10 p-8 bg-white rounded-xl border border-[#EAEFFC] shadow-[0_4px_20px_rgba(104,95,214,0.05)] font-mono">
  
  <%# Header %>
  <div class="mb-6 pb-4 border-b border-[#EAEFFC]">
    <h1 class="text-xl font-semibold text-[#4C4682] tracking-tight">
      Edit <%= @funko_pop&.name&.titleize || "Funko Pop" %>
    </h1>
    <p class="text-xs text-[#7973A8] mt-1">Update details or adjust current market value.</p>
  </div>

  <%= form_with(model: @funko_pop, class: "space-y-5") do |f| %>
    
    <%# Error Notification Block %>
    <% if @funko_pop&.errors&.any? %>
      <div class="p-4 rounded-lg bg-[#F0F2FC] border border-[#E0E3F6] text-[#4C4682] text-xs">
        <p class="font-semibold mb-1"><%= pluralize(@funko_pop.errors.count, "error") %> prohibited this pop from saving:</p>
        <ul class="list-disc list-inside space-y-1 text-[#7973A8]">
          <% @funko_pop.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Pop Name & Box Number Grid %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="md:col-span-2">
        <%= f.label :name, "POP NAME", class: "block text-xs font-semibold text-[#7973A8] tracking-wider mb-1.5" %>
        <%= f.text_field :name, placeholder: "e.g., Mewtwo", class: "w-full px-3.5 py-2.5 rounded-md border border-[#E0E3F6] bg-[#F0F2FC] text-[#4C4682] text-sm focus:bg-white focus:border-[#685FD6] focus:ring-1 focus:ring-[#685FD6] outline-none transition placeholder-[#8C87B3]" %>
      </div>

      <div>
        <%= f.label :box_num, "BOX NUM", class: "block text-xs font-semibold text-[#7973A8] tracking-wider mb-1.5" %>
        <%= f.number_field :box_num, placeholder: "581", class: "w-full px-3.5 py-2.5 rounded-md border border-[#E0E3F6] bg-[#F0F2FC] text-[#4C4682] text-sm focus:bg-white focus:border-[#685FD6] focus:ring-1 focus:ring-[#685FD6] outline-none transition placeholder-[#8C87B3]" %>
      </div>
    </div>

    <%# Cost & Current Value Grid %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :cost, "YOUR COST ($)", class: "block text-xs font-semibold text-[#7973A8] tracking-wider mb-1.5" %>
        <%= f.number_field :cost, step: "0.01", placeholder: "14.99", class: "w-full px-3.5 py-2.5 rounded-md border border-[#E0E3F6] bg-[#F0F2FC] text-[#4C4682] text-sm focus:bg-white focus:border-[#685FD6] focus:ring-1 focus:ring-[#685FD6] outline-none transition placeholder-[#8C87B3]" %>
      </div>

      <div>
        <%= f.label :current_value, "EST. VALUE ($)", class: "block text-xs font-semibold text-[#7973A8] tracking-wider mb-1.5" %>
        <%= f.number_field :current_value, step: "0.01", placeholder: "19.99", class: "w-full px-3.5 py-2.5 rounded-md border border-[#E0E3F6] bg-[#F0F2FC] text-[#4C4682] text-sm focus:bg-white focus:border-[#685FD6] focus:ring-1 focus:ring-[#685FD6] outline-none transition placeholder-[#8C87B3]" %>
      </div>
    </div>

    <%# Checkboxes for Limited Edition / Exclusive %>
    <div class="flex items-center gap-6 pt-2 pb-1">
      <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-[#7973A8]">
        <%= f.check_box :limited_edition, class: "rounded border-[#E0E3F6] text-[#685FD6] focus:ring-[#685FD6] w-4 h-4 cursor-pointer" %>
        LIMITED EDITION
      </label>

      <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-[#7973A8]">
        <%= f.check_box :exclusive, class: "rounded border-[#E0E3F6] text-[#685FD6] focus:ring-[#685FD6] w-4 h-4 cursor-pointer" %>
        EXCLUSIVE
      </label>
    </div>

    <%# Notes %>
    <div>
      <%= f.label :note, "NOTES", class: "block text-xs font-semibold text-[#7973A8] tracking-wider mb-1.5" %>
      <%= f.text_area :note, rows: 3, placeholder: "Condition notes, retailer stickers, box flaws...", class: "w-full px-3.5 py-2.5 rounded-md border border-[#E0E3F6] bg-[#F0F2FC] text-[#4C4682] text-sm focus:bg-white focus:border-[#685FD6] focus:ring-1 focus:ring-[#685FD6] outline-none transition placeholder-[#8C87B3]" %>
    </div>

    <%# Action Buttons %>
    <div class="pt-4 flex items-center justify-end gap-3 border-t border-[#EAEFFC]">
      <%= link_to "Cancel", funko_pops_path, class: "px-4 py-2 rounded-md border border-[#E0E3F6] text-[#7973A8] hover:text-[#685FD6] hover:border-[#685FD6] text-xs font-medium transition" %>
      <%= f.submit "Update Funko Pop", class: "px-5 py-2 rounded-md bg-[#685FD6] hover:bg-[#4C4682] text-white text-xs font-medium transition cursor-pointer shadow-sm" %>
    </div>

  <% end %>
</div>