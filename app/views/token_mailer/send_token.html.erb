<div style="font-family: system-ui, -apple-system, sans-serif; padding: 24px; color: #1e1b4b; max-width: 600px; background-color: #ffffff; border-radius: 12px; border: 1px solid #e0e7ff;">
  <h2 style="color: #6366f1; margin-top: 0; font-size: 22px;">Your Bearer Token</h2>
  <p style="font-size: 15px; color: #3730a3; margin-bottom: 16px;">Here is your requested authentication token:</p>
  
  <pre style="background: #f5f3ff; padding: 16px; border-radius: 8px; border: 1px solid #ddd6fe; color: #4c1d95; word-break: break-all; white-space: pre-wrap; font-family: monospace; font-size: 14px; margin: 0;"><%= @token %></pre>
  
  <p style="margin-top: 24px; font-size: 15px; color: #3730a3; margin-bottom: 8px;">Use this in your HTTP Authorization header:</p>
  <code style="background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; padding: 8px 12px; border-radius: 6px; font-family: monospace; font-size: 13px; display: inline-block;">Authorization: Bearer <%= @token %></code>

  <p>This token is good for the next 24 hours</p>
</div>
